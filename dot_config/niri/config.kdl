// ~/.config/niri/config.kdl

// --- Autostart ---
spawn-at-startup "noctalia";

// --- Keyboard ---

input {
    keyboard {
        xkb {
            layout "us,ara"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
}

// --- Keybinds ---
binds {
  // Show hotkeys overlay
   Mod+Shift+Slash { show-hotkey-overlay; }

  // Open the Nocatalia launcher
   Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }

  // Open Nocatlia's settings
   Mod+S { spawn-sh "noctalia msg settings-toggle"; }
  
  // Open Brave
   Mod+B { spawn "brave"; } 

  // Open a terminal
   Mod+Return { spawn "ghostty"; }

  // Close focused window 
   Mod+Q { close-window; }

  // Exit Niri
   Mod+Shift+E { quit; }

  // Move focus between columns (windows)
   Mod+Left { focus-column-left; }
   Mod+Right { focus-column-right; }

  // Move the focused window left/right
   Mod+Shift+Left { move-column-left; }
   Mod+Shift+Right { move-column-right; }

  // Switch workspaces vertically 
   Mod+Page_Down { focus-workspace-down; }
   Mod+Page_Up { focus-workspace-up; }

  // Move window to workspace 
   Mod+Shift+Page_Down { move-column-to-workspace-down; }
   Mod+Shift+Page_Up { move-column-to-workspace-up; }

  // Toggle floating window 
   Mod+V { toggle-window-floating; }

  // Maximize focused column
   Mod+F { maximize-column; }

  // Control center
   Mod+C { spawn-sh "noctalia msg panel-toggle control-center"; }

  // Window switcher 
   Alt+Tab { spawn-sh "noctalia msg window-switcher"; }

  // Lock screen
   Mod+Shift+L { spawn-sh "noctalia msg session lock"; }

  // Volume keys
   XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
   XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
   XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }

  // Brightness
   XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
   XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

  // Screenshots
   Mod+Shift+S { spawn-sh "noctalia msg screenshot-region"; }

  // Full screenshot (Print key)
   Print { spawn-sh "noctalia msg screenshot-fullscreen"; }
}
window-rule {
    match app-id="com.mitchellh.ghostty"
    opacity 0.8
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}
// layout
layout {
    focus-ring {
        active-color "#9D4EDD"
        inactive-color "#505050"
        width 2
    }
}



include "noctalia.kdl"
