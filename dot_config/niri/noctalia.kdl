layout {

    focus-ring {
        active-color   "#a667e4"
        inactive-color "#1e1529"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#a667e4"
        inactive-color "#1e1529"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#a667e4"
        inactive-color "#4d1485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#a667e480"
    }
}

recent-windows {
    highlight {
        active-color "#a667e4"
        urgent-color "#fd4663"
    }
}
